{ "//": "版权所有：波哥",
  "name": "chanyue",
  "private": true,
  "version": "1.11.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "build:native": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build --mode native && node scripts/check-native-bundle.mjs",
    "build:ios": "npm run build:native",
    "build:android": "npm run build:native",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "python scripts/build_android.py",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:check": "node scripts/check-native-bundle.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "1.68.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
